// ログインしている利用者が、トレイの「今すぐ確認して更新」で adguard-home-update.service を
// 管理者の確認なしに起動できるようにする（Windows 版の UpdateNow タスクと同じ）。ほかの操作は通常どおり確認を出す。
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "adguard-home-update.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
